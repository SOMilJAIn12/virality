*.key
*.pem
*.p12
*.pfx
*.crt
*.cer
*.der

# Secret/config files
secrets/
secret/
secrets.json
secret.json
credentials.json
credentials.yml
credentials.yaml

# Local config
config.local.*
settings.local.*


