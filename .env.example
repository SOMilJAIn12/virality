# ==== LLM PROVIDER ====
# Choose "ollama" (local, free) or "groq" (cloud, fast)
MODEL_PROVIDER=ollama

# ---- Ollama settings (used when MODEL_PROVIDER=ollama) ----
# Example values you might fill in: llama3.1, qwen2.5, mistral, etc.
OLLAMA_MODEL=
OLLAMA_HOST=http://localhost:11434

# ---- Groq settings (used when MODEL_PROVIDER=groq) ----
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ==== VISUAL UNDERSTANDING (Phase 4) ====
# GROQ_MODEL above is text-only and cannot see images. To ground the
# ContentProfile in the actual sampled video frames (not just their count),
# set a vision-capable Groq model here. Used ONLY for the content-profile
# step, never for personas. Leave empty to disable visual analysis (falls
# back to the original transcript-only behavior).
# NOTE: meta-llama/llama-4-scout-17b-16e-instruct was decommissioned by Groq
# (shutdown 07/17/26) and now 404s -- qwen/qwen3.6-27b is the current
# vision-capable model, but Groq serves it as PREVIEW (not production-SLA'd).
# Re-check https://console.groq.com/docs/vision periodically.
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# Master on/off switch for visual analysis. Set to false to force
# transcript-only content profiles even if a vision model is configured.
ENABLE_VISUAL_ANALYSIS=true

# ==== VISION FRAME SIZE (Phase 6A) ====
# How many frames are sampled per video, and the size/quality they're
# saved at before being sent to the vision model. Full-resolution frames
# are what caused "Request too large ... Requested 8133 / Limit 8000" --
# a small compressed thumbnail carries the same visual signal (hook,
# on-screen text, reveal moment) at a fraction of the encoded size.
# Raise these if you have a higher-tier Groq TPM limit or want sharper
# frames for a more detail-sensitive vision model.
VIDEO_NUM_FRAMES=3
VIDEO_FRAME_MAX_DIMENSION=288
VIDEO_FRAME_JPEG_QUALITY=50

# ==== CONCURRENCY ====
# Max number of persona LLM calls allowed to run at the same time.
# NOTE (Phase 3): lowered from 10 to 3. 10 concurrent calls could
# burst well past an 8000 TPM Groq limit in a single instant (each
# persona call is ~700-1000 tokens). 3 keeps the largest burst small
# enough that the token-per-minute limiter rarely needs to make
# anyone wait. Raise this if you're on a higher Groq TPM tier, or
# using local Ollama (no TPM cap).
MAX_CONCURRENT_AGENTS=3

# Tokens-per-minute budget for your Groq plan/model. Used to
# proactively throttle requests before sending them, instead of
# only reacting to 429s after the fact. Lower this if you're on a
# more restrictive tier; raise it if Groq gives you more headroom.
GROQ_TPM_LIMIT=8000

# ==== DISTRIBUTION DECISION ====
# distribution_score >= PUSH_THRESHOLD  -> PUSH to next round
# distribution_score <  PUSH_THRESHOLD  -> STOP
# NOTE: 0.70 was the original default but is unreachable given the
# weights below (max realistic score for strong content is ~0.3-0.55).
# 0.30 lets good/strong content actually PUSH while still STOPping
# weak content. See app/config.py and
# tests/test_scoring_and_aggregation.py for the reasoning.
PUSH_THRESHOLD=0.30

# ==== RECOMMENDATION SCORE WEIGHTS ====
# These are an "Instagram-inspired" simulation, NOT the real algorithm.
# They should roughly sum to 1.0 (skip penalty is subtracted separately).
COMPLETION_WEIGHT=0.30
SHARE_WEIGHT=0.25
COMMENT_WEIGHT=0.15
LIKE_WEIGHT=0.10
FOLLOW_WEIGHT=0.10
REWATCH_WEIGHT=0.10
SKIP_PENALTY=0.20

# ==== SIMULATION ROUNDS ====
# Cohort sizes per round (comma separated). The simulation stops early
# if a round's decision is STOP.
ROUND_COHORT_SIZES=15,30,60

# ==== SIMULATION SEED (Phase 5D) ====
# Optional integer seed for reproducible persona COHORT SAMPLING only
# (which personas get selected/ordered for each round). Does NOT affect
# LLM temperature or model output in any way.
# Leave empty (default) for normal, unseeded random cohort sampling on
# every run. Set to an integer to make the same video + same seed
# always sample the same cohort membership/order; a different seed can
# produce a different cohort. Can also be overridden per-run with
# `python main.py --video ... --seed <int>`.
SIMULATION_SEED=
